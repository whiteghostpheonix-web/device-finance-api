<script>
const IMEI = ${JSON.stringify(imei)};
let currentMode = 'single';
let schedules = [];

function formatUGX(n) { return Math.round(n).toLocaleString(); }

async function loadSchedules() {
  try {
    const r = await fetch('/public/schedule?imei=' + encodeURIComponent(IMEI));
    const data = await r.json();
    if (data.error) throw new Error(data.error);
    schedules = data.schedule || [];
    if (schedules.length === 0) {
      document.getElementById('balance').innerText = 'UGX 0';
      document.getElementById('due-line').innerText = 'No active plan yet. Contact support.';
      return;
    }
    render();
  } catch (e) {
    document.getElementById('balance').innerText = 'Error';
    document.getElementById('due-line').innerText = e.message;
  }
}

function render() {
  const unpaid = schedules.filter(s => s.status !== 'paid');
  const paid = schedules.filter(s => s.status === 'paid');
  const totalOwed = unpaid.reduce((sum, s) => sum + (s.amount_due_ugx - (s.amount_paid_ugx || 0)), 0);

  document.getElementById('balance').innerText = 'UGX ' + formatUGX(totalOwed);

  if (unpaid.length === 0) {
    document.getElementById('due-line').innerHTML = '';
    document.getElementById('pay-btn').disabled = true;
    document.getElementById('pay-options').style.display = 'none';
    return;
  }

  // First installment (deposit) logic
  const firstInstallment = schedules.find(s => s.installment_number === 1);
  const firstUnpaid = firstInstallment && firstInstallment.status !== 'paid';
  const firstOverdue = unpaid.find(s => s.status === 'overdue');
  const dueLine = document.getElementById('due-line');

  if (firstUnpaid) {
    const nextAmt = firstInstallment.amount_due_ugx - (firstInstallment.amount_paid_ugx || 0);
    dueLine.innerHTML =
      '<strong>Initial deposit — UGX ' + formatUGX(nextAmt) + '</strong> due ' + firstInstallment.due_date +
      (firstInstallment.status === 'overdue' ? ' <span style="color:#dc3545;">(overdue)</span>' : '');
  } else if (firstOverdue) {
    const overdueAmt = firstOverdue.amount_due_ugx - (firstOverdue.amount_paid_ugx || 0);
    dueLine.innerHTML =
      '<span style="color: #dc3545;">⚠ Overdue: <strong>Payment ' + firstOverdue.installment_number +
      ' — UGX ' + formatUGX(overdueAmt) + '</strong> (was due ' + firstOverdue.due_date + ')</span>';
  } else {
    dueLine.innerHTML = '';
  }

  // Progress text
  const per = schedules[1]?.amount_due_ugx || schedules[0]?.amount_due_ugx || 0;
  const progressWrap = document.getElementById('progress-wrap');
  progressWrap.style.display = 'block';

  let progressLines = '';
  if (firstUnpaid) {
    progressLines =
      'Initial deposit: <strong>UGX ' + formatUGX(schedules[0].amount_due_ugx) + '</strong> (one-time).<br>' +
      'Then <strong>UGX ' + formatUGX(per) + '</strong> per installment across <strong>' + (schedules.length - 1) + '</strong> installments.<br>';
  } else {
    progressLines =
      'You pay <strong>UGX ' + formatUGX(per) + '</strong> per installment.<br>';
  }
  progressLines +=
    '<strong>' + paid.length + '</strong> of <strong>' + schedules.length + '</strong> payments made · ' +
    '<strong>' + unpaid.length + '</strong> remaining.';
  progressWrap.innerHTML = progressLines;

  // Payment buttons
  const next = unpaid[0];
  const nextAmt = next.amount_due_ugx - (next.amount_paid_ugx || 0);
  document.getElementById('single-desc').innerText = 'UGX ' + formatUGX(nextAmt);
  document.getElementById('full-desc').innerText = 'UGX ' + formatUGX(totalOwed) + ' (all ' + unpaid.length + ' remaining)';

  document.getElementById('pay-options').style.display = 'block';
  document.getElementById('pay-btn').disabled = false;
  updateSummary();
}

function selectMode(mode, el) {
  currentMode = mode;
  document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  document.getElementById('custom-picker').style.display = mode === 'custom' ? 'block' : 'none';
  if (mode === 'custom') {
    const input = document.getElementById('custom-amount');
    if (!input.value) {
      const unpaid = schedules.filter(s => s.status !== 'paid');
      const next = unpaid[0];
      const nextAmt = next ? (next.amount_due_ugx - (next.amount_paid_ugx || 0)) : 500;
      input.value = Math.max(500, Math.min(Math.round(nextAmt), 1000));
    }
  }
  updateSummary();
}

function computeAmount() {
  const unpaid = schedules.filter(s => s.status !== 'paid');
  if (currentMode === 'single') {
    return Math.round(unpaid[0].amount_due_ugx - (unpaid[0].amount_paid_ugx || 0));
  } else if (currentMode === 'custom') {
    return Math.round(Number(document.getElementById('custom-amount').value) || 0);
  } else {
    return Math.round(unpaid.reduce((sum, s) => sum + (s.amount_due_ugx - (s.amount_paid_ugx || 0)), 0));
  }
}

function computeCoverage(amount) {
  const unpaid = schedules.filter(s => s.status !== 'paid');
  let remaining = amount;
  let count = 0;
  let partial = false;
  for (const s of unpaid) {
    if (remaining <= 0) break;
    const owed = s.amount_due_ugx - (s.amount_paid_ugx || 0);
    if (remaining >= owed) {
      count++;
      remaining -= owed;
    } else {
      partial = true;
      break;
    }
  }
  return { count, partial };
}

function updateSummary() {
  const amount = computeAmount();
  document.getElementById('summary-block').style.display = 'block';
  document.getElementById('summary-amount').innerText = 'UGX ' + formatUGX(amount);

  const coverageRow = document.getElementById('summary-coverage');
  const coverageText = document.getElementById('summary-coverage-text');
  const hint = document.getElementById('coverage-hint');

  if (currentMode === 'custom') {
    const cov = computeCoverage(amount);
    coverageRow.style.display = 'flex';
    if (cov.count === 0 && cov.partial) {
      coverageText.innerText = 'Partial payment';
      hint.innerText = 'Covers part of the next installment';
    } else if (cov.count === 1) {
      coverageText.innerText = '1 installment' + (cov.partial ? ' + partial' : '');
      hint.innerText = 'Covers 1 installment' + (cov.partial ? ' + part of next' : '');
    } else if (cov.count > 1) {
      coverageText.innerText = cov.count + ' installments' + (cov.partial ? ' + partial' : '');
      hint.innerText = 'Covers ' + cov.count + ' installments' + (cov.partial ? ' + part of next' : '');
    } else {
      coverageText.innerText = '—';
      hint.innerText = '';
    }
  } else {
    coverageRow.style.display = 'none';
    hint.innerText = '';
  }
}

